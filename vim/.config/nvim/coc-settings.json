{
    "java.trace.server": "verbose",
    "java.signatureHelp.enabled": true,
    "list.normalMappings": {
        "<C-c>": "do:exit"
    },
    "list.insertMappings": {
        "<C-c>": "do:exit"
    },
    "git.addGBlameToVirtualText": true,
    "git.addedSign.hlGroup": "GitGutterAdd",
    "git.changedSign.hlGroup": "GitGutterChange",
    "git.removedSign.hlGroup": "GitGutterDelete",
    "git.topRemovedSign.hlGroup": "GitGutterDelete",
    "git.enableGutters": false,
    // "clangd.path": "/usr/bin/clangd-12",
    // "clangd.path": "~/.config/coc/extensions/coc-clangd-data/install/18.1.3/clangd_18.1.3/bin/clangd",
    "codeLens.enable": true,
    "inlayHint.enable": false,
    "snippets.ultisnips.pythonPrompt": false,
    "clangd.path": "~/.config/coc/extensions/coc-clangd-data/install/20.1.8/clangd_20.1.8/bin/clangd",
    "clangd.arguments": [
        "--compile-commands-dir=.",
        "--background-index",
        "--clang-tidy",
        "--completion-style=detailed",
        "--header-insertion=iwyu"
    ],
    "clangd.fallbackFlags": [
        "-std=c++17"
    ],
    "coc.preferences.formatOnSave": true,
}
